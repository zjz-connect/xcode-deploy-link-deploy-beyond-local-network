--- a/ios/tunnel/pairrecord.go
+++ b/ios/tunnel/pairrecord.go
@@ -3,0 +4 @@ import (
+	"bytes"
@@ -39,0 +41,7 @@ type device struct {
+type pymobiledevice3PairRecord struct {
+	HostIdentifier string `plist:"host_identifier"`
+	HostAltIRK     []byte `plist:"host_alt_irk"`
+	PrivateKey     []byte `plist:"private_key"`
+	PublicKey      []byte `plist:"public_key"`
+}
+
@@ -61,0 +70,31 @@ func NewPairRecordManager(p string) (PairRecordManager, error) {
+// NewPairRecordManagerFromPymobiledevice3 reuses an existing pymobiledevice3
+// RemotePairing identity without copying the private key to Link Core storage.
+// The two projects use the same Ed25519 controller identity with different
+// plist field names.
+func NewPairRecordManagerFromPymobiledevice3(recordPath string) (PairRecordManager, error) {
+	content, err := os.ReadFile(recordPath)
+	if err != nil {
+		return PairRecordManager{}, fmt.Errorf("NewPairRecordManagerFromPymobiledevice3: failed to read record: %w", err)
+	}
+	var record pymobiledevice3PairRecord
+	if _, err := plist.Unmarshal(content, &record); err != nil {
+		return PairRecordManager{}, fmt.Errorf("NewPairRecordManagerFromPymobiledevice3: failed to parse record: %w", err)
+	}
+	if record.HostIdentifier == "" || len(record.HostAltIRK) != 16 || len(record.PrivateKey) != ed25519.SeedSize || len(record.PublicKey) != ed25519.PublicKeySize {
+		return PairRecordManager{}, fmt.Errorf("NewPairRecordManagerFromPymobiledevice3: incomplete remote pairing identity")
+	}
+	derivedPublicKey := ed25519.NewKeyFromSeed(record.PrivateKey)[ed25519.SeedSize:]
+	if !bytes.Equal(derivedPublicKey, record.PublicKey) {
+		return PairRecordManager{}, fmt.Errorf("NewPairRecordManagerFromPymobiledevice3: public and private keys do not match")
+	}
+	return PairRecordManager{
+		selfId: selfIdentity{
+			Identifier: record.HostIdentifier,
+			Irk:        record.HostAltIRK,
+			PrivateKey: record.PrivateKey,
+			PublicKey:  record.PublicKey,
+		},
+		peersLocation: path.Join(path.Dir(recordPath), "link-core-peers"),
+	}, nil
+}
+
