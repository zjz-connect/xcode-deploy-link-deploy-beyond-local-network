diff --git a/ios/tunnel/remote_pairing_raw.go b/ios/tunnel/remote_pairing_raw.go
new file mode 100644
index 0000000..b516094
--- /dev/null
+++ b/ios/tunnel/remote_pairing_raw.go
@@ -0,0 +1,72 @@
+package tunnel
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+)
+
+const remotePairingPacketMagic = "RPPairing"
+
+// remotePairingRawConn adapts the TCP RemotePairing listener to the xpcConn
+// shape consumed by controlChannelReadWriter. The raw listener carries the
+// envelope value as JSON framed by "RPPairing" and a big-endian uint16 length;
+// the RSD untrusted service carries the same value inside RemoteXPC.
+type remotePairingRawConn struct {
+	conn net.Conn
+}
+
+func newRemotePairingRawConn(conn net.Conn) *remotePairingRawConn {
+	return &remotePairingRawConn{conn: conn}
+}
+
+func (r *remotePairingRawConn) Send(data map[string]interface{}, _ ...uint32) error {
+	value, ok := data["value"].(map[string]interface{})
+	if !ok {
+		return fmt.Errorf("remotePairingRawConn.Send: missing envelope value")
+	}
+	body, err := json.Marshal(value)
+	if err != nil {
+		return fmt.Errorf("remotePairingRawConn.Send: failed to encode JSON: %w", err)
+	}
+	if len(body) > int(^uint16(0)) {
+		return fmt.Errorf("remotePairingRawConn.Send: payload exceeds uint16 framing")
+	}
+
+	var packet bytes.Buffer
+	packet.WriteString(remotePairingPacketMagic)
+	if err := binary.Write(&packet, binary.BigEndian, uint16(len(body))); err != nil {
+		return err
+	}
+	packet.Write(body)
+	if _, err := io.Copy(r.conn, &packet); err != nil {
+		return fmt.Errorf("remotePairingRawConn.Send: failed to write packet: %w", err)
+	}
+	return nil
+}
+
+func (r *remotePairingRawConn) ReceiveOnClientServerStream() (map[string]interface{}, error) {
+	magic := make([]byte, len(remotePairingPacketMagic))
+	if _, err := io.ReadFull(r.conn, magic); err != nil {
+		return nil, fmt.Errorf("remotePairingRawConn.Receive: failed to read magic: %w", err)
+	}
+	if string(magic) != remotePairingPacketMagic {
+		return nil, fmt.Errorf("remotePairingRawConn.Receive: invalid packet magic")
+	}
+	var size uint16
+	if err := binary.Read(r.conn, binary.BigEndian, &size); err != nil {
+		return nil, fmt.Errorf("remotePairingRawConn.Receive: failed to read size: %w", err)
+	}
+	body := make([]byte, int(size))
+	if _, err := io.ReadFull(r.conn, body); err != nil {
+		return nil, fmt.Errorf("remotePairingRawConn.Receive: failed to read body: %w", err)
+	}
+	var value map[string]interface{}
+	if err := json.Unmarshal(body, &value); err != nil {
+		return nil, fmt.Errorf("remotePairingRawConn.Receive: failed to decode JSON: %w", err)
+	}
+	return map[string]interface{}{"value": value}, nil
+}
diff --git a/ios/tunnel/remote_pairing_raw_test.go b/ios/tunnel/remote_pairing_raw_test.go
new file mode 100644
index 0000000..9bb2d65
--- /dev/null
+++ b/ios/tunnel/remote_pairing_raw_test.go
@@ -0,0 +1,73 @@
+package tunnel
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"io"
+	"net"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRemotePairingRawConnSend(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	raw := newRemotePairingRawConn(client)
+	errCh := make(chan error, 1)
+	go func() {
+		errCh <- raw.Send(map[string]interface{}{
+			"mangledTypeName": "RemotePairing.ControlChannelMessageEnvelope",
+			"value": map[string]interface{}{
+				"message": map[string]interface{}{"bytes": []byte{1, 2, 3}},
+			},
+		})
+	}()
+
+	magic := make([]byte, len(remotePairingPacketMagic))
+	_, err := io.ReadFull(server, magic)
+	require.NoError(t, err)
+	assert.Equal(t, remotePairingPacketMagic, string(magic))
+	var size uint16
+	require.NoError(t, binary.Read(server, binary.BigEndian, &size))
+	body := make([]byte, int(size))
+	_, err = io.ReadFull(server, body)
+	require.NoError(t, err)
+	var decoded map[string]interface{}
+	require.NoError(t, json.Unmarshal(body, &decoded))
+	assert.Equal(t, "AQID", decoded["message"].(map[string]interface{})["bytes"])
+	require.NoError(t, <-errCh)
+}
+
+func TestRemotePairingRawConnReceive(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	raw := newRemotePairingRawConn(client)
+	value := map[string]interface{}{
+		"message": map[string]interface{}{"plain": map[string]interface{}{"_0": "ok"}},
+	}
+	body, err := json.Marshal(value)
+	require.NoError(t, err)
+	go func() {
+		_, _ = server.Write([]byte(remotePairingPacketMagic))
+		_ = binary.Write(server, binary.BigEndian, uint16(len(body)))
+		_, _ = server.Write(body)
+	}()
+
+	decoded, err := raw.ReceiveOnClientServerStream()
+	require.NoError(t, err)
+	assert.Equal(t, value, decoded["value"])
+}
+
+func TestDecodeWireBytesAcceptsRawAndBase64(t *testing.T) {
+	raw := []byte{1, 2, 3}
+	decoded, err := decodeWireBytes(raw)
+	require.NoError(t, err)
+	assert.Equal(t, raw, decoded)
+	decoded, err = decodeWireBytes("AQID")
+	require.NoError(t, err)
+	assert.Equal(t, raw, decoded)
+}
diff --git a/ios/tunnel/tunnel_tcp.go b/ios/tunnel/tunnel_tcp.go
index c4fabda..600c28b 100644
--- a/ios/tunnel/tunnel_tcp.go
+++ b/ios/tunnel/tunnel_tcp.go
@@ -4,0 +5 @@ import (
+	"errors"
@@ -5,0 +7,3 @@ import (
+	"net"
+	"strconv"
+	"time"
@@ -11,0 +16,80 @@ import (
+// ConnectRemotePairingTCPUserspace establishes the iOS 18.2+ TLS-PSK tunnel
+// through an explicit RemotePairing endpoint. This avoids usbmuxd and Bonjour
+// discovery and exposes the tunnel through a local userspace TCP forwarder.
+func ConnectRemotePairingTCPUserspace(ctx context.Context, device ios.DeviceEntry, address string, remotePairingPort int, ifacePort int, p PairRecordManager) (Tunnel, error) {
+	if net.ParseIP(address) == nil {
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: endpoint must be an IP address")
+	}
+	if remotePairingPort <= 0 || remotePairingPort > 65535 {
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: invalid RemotePairing port")
+	}
+
+	controlConn, err := ios.DialTunnelTCP(net.JoinHostPort(address, strconv.Itoa(remotePairingPort)))
+	if err != nil {
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: failed to connect to RemotePairing: %w", err)
+	}
+	handshakeDeadline := remotePairingHandshakeDeadline(ctx)
+	if err := controlConn.SetDeadline(handshakeDeadline); err != nil {
+		_ = controlConn.Close()
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: failed to set handshake deadline: %w", err)
+	}
+	ts := newTunnelServiceWithControl(newRemotePairingRawConn(controlConn), controlConn, p)
+	if err := ts.VerifyPair(); err != nil {
+		_ = ts.Close()
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: pair verification failed: %w", err)
+	}
+	if err := controlConn.SetDeadline(time.Time{}); err != nil {
+		_ = ts.Close()
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: failed to clear handshake deadline: %w", err)
+	}
+
+	tunnelPort, err := ts.createTcpTunnelListener()
+	if err != nil {
+		_ = ts.Close()
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: failed to create TCP tunnel listener: %w", err)
+	}
+	dataConn, err := ios.DialTunnelTCP(net.JoinHostPort(address, strconv.Itoa(int(tunnelPort))))
+	if err != nil {
+		_ = ts.Close()
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: failed to connect to TCP tunnel listener: %w", err)
+	}
+	if err := dataConn.SetDeadline(remotePairingHandshakeDeadline(ctx)); err != nil {
+		_ = dataConn.Close()
+		_ = ts.Close()
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: failed to set data handshake deadline: %w", err)
+	}
+	tlsConn, err := tlspsk.Client(dataConn, ts.sharedSecret)
+	if err != nil {
+		_ = dataConn.Close()
+		_ = ts.Close()
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: TLS-PSK handshake failed: %w", err)
+	}
+
+	tun, err := connectToUserspaceTunnelLockdown(ctx, device, tlsConn, ifacePort)
+	if err != nil {
+		_ = tlsConn.Close()
+		_ = ts.Close()
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: userspace tunnel failed: %w", err)
+	}
+	if err := tlsConn.SetDeadline(time.Time{}); err != nil {
+		_ = tun.Close()
+		_ = ts.Close()
+		return Tunnel{}, fmt.Errorf("ConnectRemotePairingTCPUserspace: failed to clear data handshake deadline: %w", err)
+	}
+	tun.UserspaceTUN = true
+	tun.UserspaceTUNPort = ifacePort
+	originalClose := tun.closer
+	tun.closer = func() error {
+		return errors.Join(originalClose(), ts.Close())
+	}
+	return tun, nil
+}
+
+func remotePairingHandshakeDeadline(ctx context.Context) time.Time {
+	deadline := time.Now().Add(8 * time.Second)
+	if contextDeadline, ok := ctx.Deadline(); ok && contextDeadline.Before(deadline) {
+		return contextDeadline
+	}
+	return deadline
+}
+
